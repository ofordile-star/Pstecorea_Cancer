"""
07_Figure4_Diagram.py

Reconstruction of Figure 4 -- the two-column causal/evidence schematic
comparing the Gambian child (low WAZ) and Western adult (depleted
microbiome) pathways from context -> P. stercorea abundance -> immune
mechanism -> outcome.

PROVENANCE NOTE: unlike Figures 2 and 3, no Python script for this figure
was among the originally deposited files (01-06) -- the only input available
was the finished PDF. This script is a from-scratch matplotlib reconstruction
built by reading that PDF, not a recovered original. Check it carefully
against the original before use; box wording is reproduced as closely as
possible but hand-transcribed.

ARROW DIRECTION -- CHANGED FROM THE ORIGINAL: in the original PDF, arrows
point upward (each box points to the one above it), which reads as
"Reduced ARI frequency" (the bottom box, an observed OUTCOME) causing
"Immunosurveillance competence", which causes "...CRP", which causes
"...immune signalling", which causes "P. stercorea abundance", which causes
"Nutritional vulnerability" (the top box, background CONTEXT) -- i.e.
outcome-to-cause, backwards from the narrative the box text itself
describes. This version points arrows DOWNWARD instead: context ->
P. stercorea abundance -> immune signalling -> CRP -> immunosurveillance ->
ARI outcome -> testable predictions, matching a standard upstream-cause-to-
downstream-effect reading and matching the direction already used for the
final "-> Testable predictions" connector in the original. Confirm this
reading matches your intent before using it; if the original upward
direction was deliberate (e.g., an evidentiary "this supports the claim
above" ladder rather than a causal chain), change ARROW_DIRECTION below.
"""

import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch, FancyArrowPatch
from matplotlib.lines import Line2D

ARROW_DIRECTION = 'down'  # 'down' (corrected) or 'up' (matches original PDF)

# Colours
COL_OBSERVED = ('#dbe9f7', '#1a5fa0')     # fill, edge -- P. stercorea present/protective (observed)
COL_ABSENT = ('#fbe3cf', '#c2691a')       # fill, edge -- P. stercorea absent/depleted
COL_HYPOTH = ('#e9e9e9', '#666666')       # fill, edge -- hypothesised, not tested
COL_ZONE = ('#f1ecfa', '#6a3fa0')         # fill, edge -- hypothesis zone (dashed)
COL_PRED = ('#ece3fb', '#5a2d8f')         # fill, edge -- testable predictions

# Row definitions: (left_text, right_text, style, dashed)
ROWS = [
    ("Nutritional vulnerability\nLow weight-for-age (low WAZ)",
     "Industrial microbiome depletion\nDiet, antibiotics, reduced diversity",
     COL_ABSENT, False),
    ("P. stercorea\nHigh gut abundance at baseline",
     "P. stercorea\nLow or absent gut abundance",
     None, False),  # special: left=observed colour, right=absent colour
    ("Altered microbial-host immune signalling\nMechanism not established\n(e.g. possible LPS/SCFA-TLR pathways)",
     "Altered microbial-host immune signalling\nMechanism not established;\nno data tested here",
     COL_ZONE, True),
    ("Lower systemic CRP\nObserved association, low-WAZ children",
     "Elevated inflammatory tone\nHypothesised, not tested here",
     None, False),  # special: left=observed, right=hypothesised
    ("Immunosurveillance competence\nConsistent with observed data",
     "Impaired immunosurveillance\nHypothesised, not tested here",
     None, False),
    ("Reduced ARI frequency\nIRR = 0.946 overall\nIRR = 0.916 in low-WAZ children",
     "Permissive oncogenic environment\nHypothesised; not supported\nby data in this manuscript",
     None, False),
]

ROW_STYLES_LR = [
    None,
    (COL_OBSERVED, COL_ABSENT),
    None,
    (COL_OBSERVED, COL_HYPOTH),
    (COL_OBSERVED, COL_HYPOTH),
    (COL_OBSERVED, COL_HYPOTH),
]

COL_X = {'L': 0.27, 'R': 0.73}
BOX_W = 0.40
ROW_Y_TOP = 0.88
ROW_H = 0.105
ROW_GAP = 0.028


def draw_box(ax, x, y, text, fill, edge, dashed=False, fontsize=10.5, bold_first_line=True):
    w, h = BOX_W, ROW_H
    box = FancyBboxPatch((x - w / 2, y - h / 2), w, h,
                          boxstyle="round,pad=0.006,rounding_size=0.01",
                          facecolor=fill, edgecolor=edge, linewidth=1.6,
                          linestyle='dashed' if dashed else 'solid')
    ax.add_patch(box)
    lines = text.split('\n')
    n = len(lines)
    for i, line in enumerate(lines):
        yy = y + (n - 1) / 2 * 0.028 - i * 0.028
        ax.text(x, yy, line, ha='center', va='center',
                fontsize=fontsize, fontweight='bold' if (i == 0 and bold_first_line) else 'normal')


def row_y(i):
    return ROW_Y_TOP - i * (ROW_H + ROW_GAP)


if __name__ == '__main__':
    fig, ax = plt.subplots(figsize=(11, 13.5), dpi=200)
    ax.set_xlim(0, 1); ax.set_ylim(-0.20, 1); ax.axis('off')

    # Column headers
    ax.text(COL_X['L'], 0.965, "Gambian child\n(low WAZ)", ha='center', fontsize=14,
            fontweight='bold', style='italic')
    ax.text(COL_X['R'], 0.965, "Western adult\n(depleted microbiome)", ha='center', fontsize=14,
            fontweight='bold', style='italic')
    ax.plot([0.5, 0.5], [-0.18, 0.99], color='#cccccc', lw=0.8, linestyle=':')

    # Draw all rows
    for i, (ltext, rtext, style, dashed) in enumerate(ROWS):
        y = row_y(i)
        lr_style = ROW_STYLES_LR[i]
        if lr_style is not None:
            (lfill, ledge), (rfill, redge) = lr_style
        else:
            lfill, ledge = style
            rfill, redge = style
        draw_box(ax, COL_X['L'], y, ltext, lfill, ledge, dashed=dashed)
        draw_box(ax, COL_X['R'], y, rtext, rfill, redge, dashed=dashed)

    # "Shared immune-metabolic vulnerability" / "HYPOTHESIS ZONE" annotations
    y_row1, y_row2 = row_y(0), row_y(1)
    y_mid = (y_row1 + y_row2) / 2
    ax.plot([0.06, 0.94], [y_mid + 0.006, y_mid + 0.006], color='#888888', lw=0.8, linestyle=':')
    ax.text(0.5, y_mid + 0.014, "Shared immune-metabolic vulnerability", ha='center', fontsize=9,
            style='italic', color='#555555')
    y_row3 = row_y(2)
    y_zone_top = (y_row2 + y_row3) / 2
    ax.text(0.5, y_zone_top, "HYPOTHESIS ZONE", ha='center', fontsize=10, fontweight='bold',
            color='#6a3fa0')

    # Arrows between successive rows, for each column
    for i in range(len(ROWS) - 1):
        y_from, y_to = row_y(i), row_y(i + 1)
        top = y_from - ROW_H / 2 - 0.004
        bottom = y_to + ROW_H / 2 + 0.004
        for cx in COL_X.values():
            if ARROW_DIRECTION == 'down':
                start, end = (cx, top), (cx, bottom)
            else:
                start, end = (cx, bottom), (cx, top)
            arrow = FancyArrowPatch(start, end, arrowstyle='-|>', mutation_scale=14,
                                     color='#333333', lw=1.3)
            ax.add_patch(arrow)

    # Testable predictions box + connectors
    y_last = row_y(len(ROWS) - 1)
    y_pred = y_last - ROW_H - 0.075
    pred_w, pred_h = 0.62, 0.075
    pred_box = FancyBboxPatch((0.5 - pred_w / 2, y_pred - pred_h / 2), pred_w, pred_h,
                               boxstyle="round,pad=0.006,rounding_size=0.012",
                               facecolor=COL_PRED[0], edgecolor=COL_PRED[1], linewidth=1.8,
                               clip_on=False)
    ax.add_patch(pred_box)
    ax.text(0.5, y_pred + 0.014, "Testable predictions", ha='center', fontsize=12.5, fontweight='bold')
    ax.text(0.5, y_pred - 0.014, "Adult cohort studies \u00b7 gnotobiotic models \u00b7 immunotherapy datasets",
            ha='center', fontsize=9.5)

    last_box_bottom = y_last - ROW_H / 2 - 0.004
    pred_top = y_pred + pred_h / 2 + 0.004
    for cx in COL_X.values():
        if ARROW_DIRECTION == 'down':
            start, end = (cx, last_box_bottom), (cx, pred_top)
        else:
            start, end = (cx, pred_top), (cx, last_box_bottom)
        arrow = FancyArrowPatch(start, end, arrowstyle='-|>', mutation_scale=14,
                                 color='#4a2d7a', lw=1.5)
        ax.add_patch(arrow)

    # Legend -- drawn manually (rather than ax.legend) so it sits at a fixed
    # data-coordinate position clearly below the "Testable predictions" box,
    # well within the now-extended ylim so nothing gets clipped.
    legend_items = [
        (COL_OBSERVED, 'P. stercorea present / protective (observed)', False),
        (COL_HYPOTH, 'Hypothesised, not tested in this manuscript', False),
        (COL_ABSENT, 'P. stercorea absent / depleted', False),
        (COL_ZONE, 'Hypothesis zone (mechanism not established)', True),
    ]
    legend_y_top = -0.115
    row_h_legend = 0.032
    col_x = [0.10, 0.56]
    for i, (fc_ec, label, dashed) in enumerate(legend_items):
        fc, ec = fc_ec
        col = i % 2
        row = i // 2
        x0 = col_x[col]
        y0 = legend_y_top - row * row_h_legend
        swatch = plt.Rectangle((x0, y0 - 0.011), 0.035, 0.020, facecolor=fc, edgecolor=ec,
                                linewidth=1.4, linestyle='dashed' if dashed else 'solid',
                                clip_on=False)
        ax.add_patch(swatch)
        ax.text(x0 + 0.045, y0 - 0.001, label, fontsize=9, va='center', ha='left', clip_on=False)

    direction_note = "arrows: upstream context -> downstream outcome (corrected)" if ARROW_DIRECTION == 'down' \
        else "arrows: outcome -> upstream context (matches original PDF)"
    fig.text(0.5, 0.005, direction_note, ha='center', fontsize=7, color='#999999', style='italic')

    plt.savefig('Figure4_full.pdf', bbox_inches='tight', facecolor='white')
    plt.savefig('Figure4_full.png', dpi=200, bbox_inches='tight', facecolor='white')
    print(f"Saved Figure4_full.pdf/.png with ARROW_DIRECTION='{ARROW_DIRECTION}'")
