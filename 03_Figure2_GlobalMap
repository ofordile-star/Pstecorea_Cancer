    red_cmap = LinearSegmentedColormap.from_list('red', ['#fff0ec', '#fccbb5', '#f4906a', '#d94f28', '#8c1e0a'])
    PREV_BREAKS = [8, 20, 40, 70]
    CANC_BREAKS = [50, 100, 200, 300]
    prev_tier_colors = {i + 1: purple_cmap(i / 4) for i in range(5)}
    canc_tier_colors = {i + 1: red_cmap(i / 4) for i in range(5)}

    prev_color_map = {}
    prev_tier_map = {}
    for name, pct in prevotella_pct.items():
        t = bin_to_tier(pct, PREV_BREAKS)
        prev_tier_map[name] = t
        prev_color_map[name] = prev_tier_colors.get(t, '#e8e8e8')

    canc_color_map = {}
    canc_tier_map = {}
    for name, asr in cancer_asr.items():
        t = bin_to_tier(asr, CANC_BREAKS)
        canc_tier_map[name] = t
        canc_color_map[name] = canc_tier_colors.get(t, '#e8e8e8')

    # Panel C: bivariate overlay classification (see NOTE in module docstring)
    COL_HIGH_LOW = '#4040c8'   # High Prevotella + Low Cancer
    COL_LOW_HIGH = '#e0356b'   # Low Prevotella + High Cancer
    COL_MIXED = '#9c5f8a'      # Mixed / transition
    COL_NODATA = '#bdbdbd'
    overlay_color_map = {}
    all_names = set(prev_tier_map) | set(canc_tier_map)
    for name in all_names:
        pt, ct = prev_tier_map.get(name), canc_tier_map.get(name)
        if pt is None or ct is None:
            overlay_color_map[name] = COL_NODATA
        elif pt >= 4 and ct <= 2:
            overlay_color_map[name] = COL_HIGH_LOW
        elif pt <= 2 and ct >= 4:
            overlay_color_map[name] = COL_LOW_HIGH
        else:
            overlay_color_map[name] = COL_MIXED

    # ------------------------------------------------------------------
    # Figure layout
    # ------------------------------------------------------------------
    fig = plt.figure(figsize=(18, 13), dpi=200)

    fig.text(0.5, 0.985, r"$\it{Prevotella\ stercorea}$  $\leftrightarrow$  $\bf{Immunity}$  $\leftrightarrow$  $\bf{Cancer}$",
              ha='center', fontsize=24, color='#3d0a5c', family='serif')
    fig.text(0.5, 0.965, "From Microbiome to Immune Modulation to Cancer Risk: A Global Overlay",
              ha='center', fontsize=13, color='#333333')

    # Panel A
    ax1 = fig.add_axes([0.02, 0.62, 0.40, 0.30])
    draw_map(ax1, country_geoms, id_to_name, decoded_arcs, prev_color_map)
    fig.text(0.22, 0.925, 'A. Prevotella stercorea Abundance', ha='center', fontsize=14, fontweight='bold',
              color='white', bbox=dict(boxstyle='square,pad=0.5', facecolor='#4a1a6b', edgecolor='none'))
    fig.text(0.22, 0.905, '(Illustrative extrapolation from genus-level relative abundance)',
              ha='center', fontsize=9, style='italic', color='#444444')
    draw_legend(ax1, 0.02, 0.62, [
        (prev_tier_colors[5], 'Very High'), (prev_tier_colors[4], 'High'),
        (prev_tier_colors[3], 'Moderate'), (prev_tier_colors[2], 'Low'),
        (prev_tier_colors[1], 'Very Low'), ('#e8e8e8', 'No Data'),
    ])
    _prev_raw = pd.read_csv('country_prevotella_summary.csv')
    n_any_data = len(_prev_raw)  # total distinct countries/regions with any direct sample data
    n_direct = int((_prev_raw['n_samples'] >= 20).sum())  # meeting the n>=20 direct-value threshold
    total_samples = int(_prev_raw['n_samples'].sum())
    ax1.text(0.0, -0.04,
             f"Sources: computed directly from Abdill et al. 2025 primary data\n"
             f"({total_samples/1000:.0f}K samples/{n_any_data} countries). Direct country-level value where n>=20\n"
             f"({n_direct} countries); UN-subregion average for same-region countries with\n"
             f"direct data elsewhere. Yeoh 2022; De Filippo 2010; IHAT-GUT.",
             transform=ax1.transAxes, fontsize=7, style='italic', color='#666666', va='top')

    # Panel B
    ax2 = fig.add_axes([0.58, 0.62, 0.40, 0.30])
    draw_map(ax2, country_geoms, id_to_name, decoded_arcs, canc_color_map)
    fig.text(0.78, 0.925, 'B. Cancer Incidence (All Cancers)', ha='center', fontsize=14, fontweight='bold',
              color='white', bbox=dict(boxstyle='square,pad=0.5', facecolor='#8c1a10', edgecolor='none'))
    fig.text(0.78, 0.907, 'Age-Standardized Rate per 100,000 (Both Sexes)',
              ha='center', fontsize=9, style='italic', color='#444444')
    draw_legend(ax2, 0.02, 0.58, [
        (canc_tier_colors[5], 'Very High (\u2265300)'), (canc_tier_colors[4], 'High (200-300)'),
        (canc_tier_colors[3], 'Moderate (100-200)'), (canc_tier_colors[2], 'Low (50-100)'),
        (canc_tier_colors[1], 'Very Low (<50)'), ('#e8e8e8', 'No Data'),
    ])
    n_ci5_direct = int(pd.read_csv('ci5_country_period_avg.csv')['iso3'].notna().sum())
    n_ci5_map_total = len(cancer_asr)
    ax2.text(0.0, -0.04,
             f"Source: IARC CI5-XII (2013-2017), period-average ASR (World std.),\n"
             f"pop.-weighted per country. {n_ci5_direct}/{n_ci5_map_total} direct registry data;\n"
             f"remainder via same UN-subregion average or GLOBOCAN 2024 (no subregion peer).",
             transform=ax2.transAxes, fontsize=7, style='italic', color='#666666', va='top')

    # Center causal-chain text (drawn on a dedicated full-figure overlay axes
    # so we can use axes-level annotate() for the arrows)
    arrow_ax = fig.add_axes([0, 0, 1, 1])
    arrow_ax.axis('off')
    arrow_ax.set_xlim(0, 1); arrow_ax.set_ylim(0, 1)
    fig.text(0.50, 0.905, r"$\it{Prevotella\ stercorea}$", ha='center', fontsize=12, color='#4a1a6b', style='italic')
    fig.text(0.50, 0.886, "Modulates Immune System", ha='center', fontsize=10.5, color='#4a1a6b', fontweight='bold')
    arrow_ax.annotate('', xy=(0.50, 0.850), xytext=(0.50, 0.874),
                       arrowprops=dict(arrowstyle='-|>', color='#4a1a6b', lw=1.5))
    fig.text(0.50, 0.832, "Immune System (Innate + Adaptive)", ha='center', fontsize=10.5, color='#1a3a6b', fontweight='bold')
    fig.text(0.50, 0.814, "Modulates Cancer Risk", ha='center', fontsize=10.5, color='#1a3a6b', fontweight='bold')
    arrow_ax.annotate('', xy=(0.50, 0.778), xytext=(0.50, 0.802),
                       arrowprops=dict(arrowstyle='-|>', color='#8c1a10', lw=1.5))
    fig.text(0.50, 0.758, "Altered Cancer Susceptibility", ha='center', fontsize=11.5, color='#8c1a10', fontweight='bold')

    # Panel C: overlay
    ax3 = fig.add_axes([0.02, 0.09, 0.55, 0.44])
    draw_map(ax3, country_geoms, id_to_name, decoded_arcs, overlay_color_map)
    fig.text(0.30, 0.535, 'C. Overlay: Prevotella stercorea Abundance vs Cancer Incidence',
              ha='center', fontsize=14, fontweight='bold', color='#222222')
    fig.text(0.30, 0.515, '(Purple = Higher Prevotella stercorea, Red = Higher Cancer Incidence)',
              ha='center', fontsize=9.5, style='italic', color='#444444')
    draw_legend(ax3, 0.02, 0.41, [
        (COL_HIGH_LOW, 'High P. stercorea + Low Cancer\n(e.g., rural Africa, South Asia)'),
        (COL_LOW_HIGH, 'Low P. stercorea + High Cancer\n(e.g., N. America, Europe, Australia)'),
        (COL_MIXED, 'Mixed / Transition Zones\n(e.g., Latin America, China, Middle East)'),
        (COL_NODATA, 'No Data'),
    ], box_h=0.045, gap=0.028, fontsize=10.5)

    # Panel D: correlation scatter
    ax4 = fig.add_axes([0.635, 0.185, 0.33, 0.33])
    ax4.scatter(corr_df['pct_prevotella_gt1'], corr_df['ASR_period_avg'], s=32, alpha=0.65,
                color='#4a1a6b', edgecolor='none')
    slope, intercept = np.polyfit(corr_df['pct_prevotella_gt1'], corr_df['ASR_period_avg'], 1)
    xr = np.linspace(corr_df['pct_prevotella_gt1'].min(), corr_df['pct_prevotella_gt1'].max(), 50)
    ax4.plot(xr, slope * xr + intercept, color='#8c1a10', lw=2)
    stats_box = (f"Raw: r={CURRENT_STATS['raw_r']:.2f}, p={CURRENT_STATS['raw_p']:.1e}, n={CURRENT_STATS['raw_n']}\n"
                 f"Age+smoking-adj.:\nr={CURRENT_STATS['adj_r']:.2f}, p={CURRENT_STATS['adj_p']:.3f}, n={CURRENT_STATS['adj_n']}")
    ax4.text(0.97, 0.95, stats_box, transform=ax4.transAxes, fontsize=9.5, ha='right', va='top',
              bbox=dict(boxstyle='round', facecolor='white', edgecolor='#999999', alpha=0.95))
    ax4.set_xlabel('% samples Prevotella >1%', fontsize=10)
    ax4.set_ylabel('Cancer ASR (period-avg)', fontsize=10)
    ax4.set_title('D. Country-level correlation', fontsize=13, fontweight='bold', loc='left')
    for spine in ['top', 'right']: ax4.spines[spine].set_visible(False)
    fig.text(0.80, 0.100, "Key Takeaway: higher P. stercorea abundance associates with lower cancer incidence.\n"
                           "Ecological comparison; does not establish causation.",
              ha='center', fontsize=8.5, style='italic', color='#333333')

    # Footer disclaimer box
    footer_ax = fig.add_axes([0.02, 0.005, 0.615, 0.075])
    footer_ax.axis('off')
    footer_ax.add_patch(plt.Rectangle((0, 0), 1, 1, transform=footer_ax.transAxes,
                                       facecolor='#fdf6d8', edgecolor='#c9b84a', linewidth=1))
    footer_ax.text(0.015, 0.85,
        "This visualization is a high-level ecological comparison for hypothesis generation only.",
        transform=footer_ax.transAxes, fontsize=9, fontweight='bold', va='top')
    footer_ax.text(0.015, 0.60,
        "It does not imply causation. Many confounders exist (diet, lifestyle, infections, genetics, healthcare access, screening, lifespan, reporting quality).",
        transform=footer_ax.transAxes, fontsize=7.8, va='top', color='#444444')
    footer_ax.text(0.015, 0.36,
        "Cancer data: IARC CI5-XII period-average (2013-2017), matching Panel D's correlation dataset.",
        transform=footer_ax.transAxes, fontsize=7.8, va='top', color='#444444')
    footer_ax.text(0.015, 0.14,
        f"Using GLOBOCAN 2024 single-year estimates instead yields a materially identical correlation "
        f"(r={CURRENT_STATS['globocan_r']:.2f}, p={CURRENT_STATS['globocan_p']:.1e}, n={CURRENT_STATS['globocan_n']} "
        f"vs period-average r={CURRENT_STATS['raw_r']:.2f}, p={CURRENT_STATS['raw_p']:.1e}, n={CURRENT_STATS['raw_n']}; Supplementary Table S2).",
        transform=footer_ax.transAxes, fontsize=7.8, va='top', color='#444444')

    plt.savefig('Figure2_full.pdf', bbox_inches='tight', facecolor='white')
    plt.savefig('Figure2_full.png', dpi=200, bbox_inches='tight', facecolor='white')
    print(f"Saved Figure2_full.pdf/.png. Raw correlation: r={r:.3f}, p={p:.3g}, n={len(corr_df)}")
