# ---------------------------------------------------------------------------
# TopoJSON decoding (minimal, no external geo library required)
# ---------------------------------------------------------------------------
def decode_topojson(topo):
    transform = topo.get('transform')
    def decode_arc(arc):
        if transform:
            scale, translate = transform['scale'], transform['translate']
            x = y = 0; pts = []
            for dx, dy in arc:
                x += dx; y += dy
                pts.append((x * scale[0] + translate[0], y * scale[1] + translate[1]))
            return pts
        return [(p[0], p[1]) for p in arc]
    return [decode_arc(a) for a in topo['arcs']]

def arc_coords(arcs, idx):
    return arcs[idx] if idx >= 0 else list(reversed(arcs[~idx]))

def geom_to_paths(geom, decoded_arcs):
    polys = []
    if geom['type'] == 'Polygon':
        rings = [sum((arc_coords(decoded_arcs, ai) for ai in ring), []) for ring in geom['arcs']]
        polys.append(rings)
    elif geom['type'] == 'MultiPolygon':
        for poly_arcs in geom['arcs']:
            rings = [sum((arc_coords(decoded_arcs, ai) for ai in ring), []) for ring in poly_arcs]
            polys.append(rings)
    return polys

def make_path_patch(rings, **kwargs):
    verts, codes = [], []
    for ring in rings:
        if len(ring) < 3: continue
        verts.append(ring[0]); codes.append(Path.MOVETO)
        for pt in ring[1:]:
            verts.append(pt); codes.append(Path.LINETO)
        verts.append(ring[0]); codes.append(Path.CLOSEPOLY)
    return PathPatch(Path(verts, codes), **kwargs) if verts else None

def draw_map(ax, country_geoms, id_to_name, decoded_arcs, color_dict,
             nodata_color='#e8e8e8', edge='#999999', lw=0.3):
    for g in country_geoms:
        name = id_to_name.get(g['id'])
        color = color_dict.get(name, nodata_color) if name else nodata_color
        for rings in geom_to_paths(g, decoded_arcs):
            patch = make_path_patch(rings, facecolor=color, edgecolor=edge, linewidth=lw)
            if patch: ax.add_patch(patch)
    ax.set_xlim(-180, 180); ax.set_ylim(-58, 83); ax.set_aspect(1.35); ax.axis('off')

def bin_to_tier(pct, breaks):
    if pct is None or (isinstance(pct, float) and np.isnan(pct)):
        return None
    for i, b in enumerate(breaks):
        if pct < b:
            return i + 1
    return len(breaks) + 1

def draw_legend(ax, x, y, entries, box_w=0.028, box_h=0.030, gap=0.008, fontsize=10):
    """entries: list of (color, label). Drawn top-to-bottom at axes-fraction (x,y)."""
    for i, (color, label) in enumerate(entries):
        yy = y - i * (box_h + gap)
        ax.add_patch(plt.Rectangle((x, yy - box_h), box_w, box_h, transform=ax.transAxes,
                                    facecolor=color, edgecolor='#555555', linewidth=0.5,
                                    clip_on=False))
        ax.text(x + box_w + 0.012, yy - box_h / 2, label, transform=ax.transAxes,
                fontsize=fontsize, va='center', ha='left')


if __name__ == '__main__':
    topo = json.load(open(WORLD_TOPOJSON))
    decoded_arcs = decode_topojson(topo)
    country_geoms = topo['objects']['countries']['geometries']
    id_to_name = {}
