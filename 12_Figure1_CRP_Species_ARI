library(tidyverse)
library(broom)
library(MASS)
library(patchwork)

rds_dir    <- "C:/Users/oofordile/Desktop/IHAT_Paper2_RDS/"
output_dir <- "C:/Users/oofordile/Desktop/Cancer_Paper_Results/"
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)

mb_raw <- readRDS(file.path(rds_dir, "mb_full.rds"))

# Normalize column names
mb <- mb_raw %>%
  rename(
    age_sampling  = any_of(c("age at sampling", "age_sampling")),
    age_enrolment = any_of(c("age at enrolment", "age_enrolment"))
  )

# Robust feature engineering based on column availability
if ("Prevotella_stercorea_7.05" %in% names(mb)) {
  mb <- mb %>% mutate(log_Pstercorea = log1p(Prevotella_stercorea_7.05))
} else if (!"log_Pstercorea" %in% names(mb)) {
  stop("Neither Prevotella_stercorea_7.05 nor log_Pstercorea found in dataset.")
}

if ("Prevotella_copri_35.15" %in% names(mb)) {
  mb <- mb %>% mutate(log_Pcopri = log1p(Prevotella_copri_35.15))
} else if (!"log_Pcopri" %in% names(mb)) {
  stop("Neither Prevotella_copri_35.15 nor log_Pcopri found in dataset.")
}

if ("CRP" %in% names(mb)) {
  mb <- mb %>% mutate(log_CRP = log1p(CRP))
} else if (!"log_CRP" %in% names(mb)) {
  stop("Neither CRP nor log_CRP found in dataset.")
}

if ("AGP" %in% names(mb)) {
  mb <- mb %>% mutate(log_AGP = log1p(AGP))
} else if (!"log_AGP" %in% names(mb)) {
  stop("Neither AGP nor log_AGP found in dataset.")
}

if ("gender" %in% names(mb)) {
  mb <- mb %>% mutate(gender_n = as.integer(gender == "Male"))
} else if (!"gender_n" %in% names(mb)) {
  stop("Neither gender nor gender_n found in dataset.")
}

# ---------------------------------------------------------------------------
# SHARED DATA: D1 same-timepoint dataset (Panels A-C)
# ---------------------------------------------------------------------------
d1 <- mb %>%
  filter(timepoints == "D1") %>%
  dplyr::select(rand_no, WAZ_enrolment, log_CRP, log_AGP, log_Pstercorea, log_Pcopri,
                HAZ_enrolment, age_sampling, gender_n) %>%
  drop_na()

waz_med_d1 <- median(d1$WAZ_enrolment, na.rm = TRUE)
d1 <- d1 %>%
  mutate(WAZ_group = factor(
    if_else(WAZ_enrolment <= waz_med_d1, "Low WAZ", "High WAZ"),
    levels = c("Low WAZ", "High WAZ")))

d_low  <- d1 %>% filter(WAZ_group == "Low WAZ")
d_high <- d1 %>% filter(WAZ_group == "High WAZ")

# ---------------------------------------------------------------------------
# PANEL A: dose-response, P. stercorea -> CRP, Low WAZ
# ---------------------------------------------------------------------------
fit_A <- lm(log_CRP ~ log_Pstercorea + HAZ_enrolment + age_sampling + gender_n, data = d_low)
tidy_A <- tidy(fit_A, conf.int = TRUE) %>% filter(term == "log_Pstercorea")

panel_A <- ggplot(d_low, aes(log_Pstercorea, log_CRP)) +
  geom_point(alpha = 0.45, size = 1.5, color = "#4a1a6b") +
  geom_smooth(method = "lm", formula = y ~ x, color = "#8c1a10", fill = "#f4b8ad", se = TRUE) +
  labs(x = "log(1+x) P. stercorea, D1", y = "log(1+x) CRP, D1") +
  theme_classic(base_size = 11) +
  theme(plot.title = element_text(face = "bold"))

# ---------------------------------------------------------------------------
# PANEL B: species specificity
# ---------------------------------------------------------------------------
fit_ps_marg <- lm(log_CRP ~ log_Pstercorea + HAZ_enrolment + age_sampling + gender_n, data = d_low)
fit_pc_marg <- lm(log_CRP ~ log_Pcopri      + HAZ_enrolment + age_sampling + gender_n, data = d_low)
fit_joint   <- lm(log_CRP ~ log_Pstercorea + log_Pcopri + HAZ_enrolment + age_sampling + gender_n, data = d_low)

b_levels <- c(
  "P. copri\n(adj. P. stercorea)",
  "P. stercorea\n(adj. P. copri)",
  "P. copri\n(marginal)",
  "P. stercorea\n(marginal)"
)

panel_B_df <- bind_rows(
  tidy(fit_ps_marg, conf.int = TRUE) %>% filter(term == "log_Pstercorea") %>% mutate(label = "P. stercorea\n(marginal)"),
  tidy(fit_pc_marg, conf.int = TRUE) %>% filter(term == "log_Pcopri")      %>% mutate(label = "P. copri\n(marginal)"),
  tidy(fit_joint,   conf.int = TRUE) %>% filter(term == "log_Pstercorea") %>% mutate(label = "P. stercorea\n(adj. P. copri)"),
  tidy(fit_joint,   conf.int = TRUE) %>% filter(term == "log_Pcopri")      %>% mutate(label = "P. copri\n(adj. P. stercorea)")
) %>%
  mutate(label = factor(label, levels = b_levels),
         sig = p.value < 0.05)

panel_B <- ggplot(panel_B_df, aes(x = estimate, y = label, color = sig)) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey60") +
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0, linewidth = 0.9) +
  geom_point(size = 2.5) +
  scale_color_manual(values = c(`TRUE` = "#8c1a10", `FALSE` = "#999999"), guide = "none") +
  coord_cartesian(xlim = c(-0.09, 0.05)) +
  labs(x = "beta (effect on log CRP)", y = NULL) +
  theme_classic(base_size = 11)

# ---------------------------------------------------------------------------
# PANEL C: D1->D1 biomarker x WAZ stratum
# ---------------------------------------------------------------------------
fit_crp_low  <- lm(log_CRP ~ log_Pstercorea + HAZ_enrolment + age_sampling + gender_n, data = d_low)
fit_crp_high <- lm(log_CRP ~ log_Pstercorea + HAZ_enrolment + age_sampling + gender_n, data = d_high)
fit_agp_low  <- lm(log_AGP ~ log_Pstercorea + HAZ_enrolment + age_sampling + gender_n, data = d_low)
fit_agp_high <- lm(log_AGP ~ log_Pstercorea + HAZ_enrolment + age_sampling + gender_n, data = d_high)

c_levels <- c("AGP, High WAZ", "AGP, Low WAZ", "CRP, High WAZ", "CRP, Low WAZ")

panel_C_df <- bind_rows(
  tidy(fit_crp_low,  conf.int = TRUE) %>% filter(term == "log_Pstercorea") %>% mutate(label = "CRP, Low WAZ"),
  tidy(fit_crp_high, conf.int = TRUE) %>% filter(term == "log_Pstercorea") %>% mutate(label = "CRP, High WAZ"),
  tidy(fit_agp_low,  conf.int = TRUE) %>% filter(term == "log_Pstercorea") %>% mutate(label = "AGP, Low WAZ"),
  tidy(fit_agp_high, conf.int = TRUE) %>% filter(term == "log_Pstercorea") %>% mutate(label = "AGP, High WAZ")
) %>%
  mutate(label = factor(label, levels = c_levels), sig = p.value < 0.05)

panel_C <- ggplot(panel_C_df, aes(x = estimate, y = label, color = sig)) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey60") +
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0, linewidth = 1.0) +
  geom_point(size = 2.8) +
  scale_color_manual(values = c(`TRUE` = "#8c1a10", `FALSE` = "#999999"), guide = "none") +
  coord_cartesian(xlim = c(-0.09, 0.05)) +
  labs(x = "beta (effect on biomarker)", y = NULL) +
  theme_classic(base_size = 11)

# ---------------------------------------------------------------------------
# Load Adverse Events data for Panel D (ARI frequency)
# ---------------------------------------------------------------------------
ae_ari_file <- file.path(rds_dir, "ae_ari.rds")
if (file.exists(ae_ari_file)) {
  ae_ari <- readRDS(ae_ari_file)
} else {
  ae_raw <- read.csv(file.path(rds_dir, "Adverse_Events.csv"))
  colnames(ae_raw) <- trimws(colnames(ae_raw))
  ae_ari <- ae_raw %>%
    filter(`AE ARI` == 1) %>%
    group_by(`Randomisation No`) %>%
    summarise(ae_freq = n(), .groups = "drop") %>%
    rename(rand_no = `Randomisation No`)
}

d85_ari <- mb %>%
  filter(timepoints == "D85") %>%
  dplyr::select(rand_no, WAZ_enrolment, log_Pstercorea, age_enrolment, gender_n, HAZ_enrolment) %>%
  drop_na(log_Pstercorea, age_enrolment, gender_n, HAZ_enrolment, WAZ_enrolment) %>%
  left_join(ae_ari, by = "rand_no") %>%
  mutate(ae_freq = replace_na(ae_freq, 0)) %>%
  filter(ae_freq <= 5)

waz_med_d85 <- median(d85_ari$WAZ_enrolment, na.rm = TRUE)
d85_ari <- d85_ari %>%
  mutate(WAZ_group = factor(
    if_else(WAZ_enrolment <= waz_med_d85, "Low WAZ", "High WAZ"),
    levels = c("Low WAZ", "High WAZ")))

# ---------------------------------------------------------------------------
# PANEL D: ARI protection & dispersion pre-test
# ---------------------------------------------------------------------------
fit_ari_stratum <- function(data, label, dispersion_threshold = 1.2) {
  pois_fit <- glm(ae_freq ~ log_Pstercorea + age_enrolment + gender_n + HAZ_enrolment,
                  data = data, family = poisson())
  dispersion_ratio <- pois_fit$deviance / pois_fit$df.residual
  cat(sprintf("%s: n=%d, Poisson deviance/df = %.3f\n", label, nrow(data), dispersion_ratio))

  if (dispersion_ratio <= dispersion_threshold) {
    cat(sprintf("  -> no meaningful overdispersion (<=%.1f); using Poisson.\n", dispersion_threshold))
    beta <- coef(pois_fit)["log_Pstercorea"]
    se   <- summary(pois_fit)$coefficients["log_Pstercorea", "Std. Error"]
    pval <- summary(pois_fit)$coefficients["log_Pstercorea", "Pr(>|z|)"]
    
    return(tibble(
      label = label,
      model = "Poisson",
      dispersion_ratio = dispersion_ratio,
      estimate = exp(beta),
      conf.low = exp(beta - 1.96 * se),
      conf.high = exp(beta + 1.96 * se),
      p.value = pval
    ))
  }

  cat(sprintf("  -> overdispersion present (>%.1f); fitting negative binomial (glm.nb).\n", dispersion_threshold))
  nb_fit <- glm.nb(ae_freq ~ log_Pstercorea + age_enrolment + gender_n + HAZ_enrolment,
                   data = data, control = glm.control(maxit = 200))
  beta <- coef(nb_fit)["log_Pstercorea"]
  se   <- summary(nb_fit)$coefficients["log_Pstercorea", "Std. Error"]
  pval <- summary(nb_fit)$coefficients["log_Pstercorea", "Pr(>|z|)"]
  
  tibble(
    label = label,
    model = "NB2",
    dispersion_ratio = dispersion_ratio,
    estimate = exp(beta),
    conf.low = exp(beta - 1.96 * se),
    conf.high = exp(beta + 1.96 * se),
    p.value = pval
  )
}

panel_D_df <- bind_rows(
  fit_ari_stratum(d85_ari, "Overall"),
  fit_ari_stratum(d85_ari %>% filter(WAZ_group == "Low WAZ"), "Low WAZ"),
  fit_ari_stratum(d85_ari %>% filter(WAZ_group == "High WAZ"), "High WAZ")
) %>%
  mutate(
    label = factor(label, levels = c("High WAZ", "Low WAZ", "Overall")),
    sig = p.value < 0.05
  )

print(panel_D_df %>% dplyr::select(label, model, dispersion_ratio, estimate, p.value))

panel_D <- ggplot(panel_D_df, aes(x = estimate, y = label, color = sig)) +
  geom_vline(xintercept = 1, linetype = "dashed", color = "grey60") +
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0, linewidth = 1.0) +
  geom_point(size = 2.8) +
  scale_color_manual(values = c(`TRUE` = "#8c1a10", `FALSE` = "#999999"), guide = "none") +
  coord_cartesian(xlim = c(0.80, 1.15)) +
  labs(x = "IRR (ARI frequency)", y = NULL) +
  theme_classic(base_size = 11)

# ---------------------------------------------------------------------------
# ASSEMBLE 2x2 AND SAVE
# ---------------------------------------------------------------------------
fig2 <- (panel_A + panel_B) / (panel_C + panel_D) +
  plot_annotation(tag_levels = "A",
                  title = "P. stercorea, inflammatory tone, and infection protection (IHAT-GUT)")

ggsave(file.path(output_dir, "Figure2_2x2.pdf"), fig2, width = 10, height = 9, dpi = 300)
ggsave(file.path(output_dir, "Figure2_2x2.png"), fig2, width = 10, height = 9, dpi = 300)

write_csv(bind_rows(
  tidy_A %>% mutate(panel = "A"),
  panel_B_df %>% mutate(panel = "B"),
  panel_C_df %>% mutate(panel = "C"),
  panel_D_df %>% mutate(panel = "D")
), file.path(output_dir, "Figure2_full_stats.csv"))

