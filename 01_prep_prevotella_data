        'Sierra Leone','Liberia',"Côte d'Ivoire",'Cameroon','Chad','Gambia'],
    'Europe and Northern America': ['United States','Canada','United Kingdom','Germany','France',
        'Italy','Spain','Portugal','Netherlands','Belgium','Switzerland','Austria','Denmark','Norway',
        'Sweden','Finland','Iceland','Ireland','Poland','Hungary','Slovakia','Czechia','Romania',
        'Bulgaria','Serbia','Croatia','Bosnia and Herzegovina','Montenegro','North Macedonia','Albania',
