        'Lithuania','Slovenia','Luxembourg','Malta'],
}

# Literature overrides where Abdill has no/insufficient direct samples
LITERATURE_OVERRIDES_PCT = {
    'Gambia': 65.0,        # IHAT-GUT direct species-level measurement (illustrative tier anchor)
    'Fiji': 36.1,          # Yeoh et al. 2022, highest of 14 sampled cohorts
    'Burkina Faso': 55.0,  # De Filippo et al. 2010, directly measured (illustrative tier anchor)
    'El Salvador': 45.0,   # Yeoh et al. 2022, high-prevalence rural cohort
    'Peru': 45.0,          # Yeoh et al. 2022, same study as El Salvador
}


def build_map_tiers(country_summary, region_summary):
    iso_to_name = {c.alpha_2: c.name for c in pycountry.countries}
    country_pct = {}
    for _, row in country_summary[country_summary['n_samples'] >= 20].iterrows():
        name = iso_to_name.get(row['iso'])
        if name:
            country_pct[name] = row['pct_prevotella_gt1']

    region_pct = dict(zip(region_summary['region'], region_summary['pct_prevotella_gt1']))

    final_pct = {}
    for region, members in REGION_MEMBERS.items():
        fallback = region_pct.get(region, np.nan)
        for c in members:
            final_pct[c] = fallback
    final_pct.update(country_pct)          # direct data overrides region fallback
    final_pct.update(LITERATURE_OVERRIDES_PCT)  # literature overrides direct/fallback

    return final_pct


if __name__ == '__main__':
    prev_by_sample = compute_prevotella_by_sample()
    country_summary, region_summary = build_country_summary(prev_by_sample)
    country_summary.to_csv('country_prevotella_summary.csv', index=False)

    final_pct = build_map_tiers(country_summary, region_summary)
    json.dump(final_pct, open('prevotella_country_pct.json', 'w'))
    print(f"Done. {len(final_pct)} countries in final map data.")
