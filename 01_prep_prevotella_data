"""
01_prep_prevotella_data.py

Builds country- and region-level Prevotella prevalence data from the
Human Microbiome Compendium primary data (Abdill et al. 2025, Cell).

INPUTS (download from https://doi.org/10.5281/zenodo.10452633):
    sample_metadata.tsv
    taxonomic_table.csv.gz

OUTPUTS:
    country_prevotella_summary.csv   -- per-country %Prevotella>1%, n_samples
    prevotella_country_tiers.json    -- final tier assignment per country
                                         (direct data where n>=20, UN-subregion
                                         average of same-region direct-data
                                         countries otherwise, literature
                                         overrides for Gambia/Fiji/Burkina Faso/
                                         El Salvador/Peru per Yeoh et al. 2022,
                                         De Filippo et al. 2010, IHAT-GUT)

Matches the source paper's own definition exactly: % of samples with
Prevotella genus relative abundance >1%, restricted to samples with
>=10,000 total reads.
"""

import pandas as pd
import numpy as np
import json
import pycountry

SAMPLE_METADATA = "sample_metadata.tsv"
TAXONOMIC_TABLE = "taxonomic_table.csv.gz"
PREVOTELLA_COL = "Bacteria.Bacteroidota.Bacteroidia.Bacteroidales.Prevotellaceae.Prevotella"

# ---------------------------------------------------------------------------
# STEP 1: per-sample Prevotella relative abundance (chunked -- table is large)
# ---------------------------------------------------------------------------
def compute_prevotella_by_sample():
    results = []
    for chunk in pd.read_csv(TAXONOMIC_TABLE, chunksize=20000):
        numeric_cols = chunk.select_dtypes(include=[np.number]).columns
        total_reads = chunk[numeric_cols].sum(axis=1)
        prevotella = chunk[PREVOTELLA_COL] if PREVOTELLA_COL in chunk.columns else 0
        results.append(pd.DataFrame({
            'sample': chunk['sample'],
            'prevotella_reads': prevotella,
            'total_reads': total_reads
        }))
    return pd.concat(results, ignore_index=True)


# ---------------------------------------------------------------------------
# STEP 2: join to country metadata, apply paper's own QC threshold
# ---------------------------------------------------------------------------
def build_country_summary(prev_by_sample):
    meta = pd.read_csv(SAMPLE_METADATA, sep='\t')
    meta['sample'] = meta['project'] + '_' + meta['srr']
    df = meta.merge(prev_by_sample, on='sample', how='inner')
    df = df[df['total_reads'] >= 10000].copy()
    df['prevotella_pct'] = df['prevotella_reads'] / df['total_reads'] * 100
    df['prevotella_gt1pct'] = df['prevotella_pct'] > 1

    country_summary = df.groupby('iso').agg(
        n_samples=('srs', 'count'),
        pct_prevotella_gt1=('prevotella_gt1pct', lambda x: 100 * x.mean()),
    ).sort_values('n_samples', ascending=False).reset_index()

    region_summary = df.groupby('region').agg(
        n_samples=('srs', 'count'),
        pct_prevotella_gt1=('prevotella_gt1pct', lambda x: 100 * x.mean()),
    ).reset_index()

    return country_summary, region_summary


# ---------------------------------------------------------------------------
# STEP 3: build final per-country tier for the map (direct data n>=20,
# else UN-subregion average using the region membership lists below)
# ---------------------------------------------------------------------------
REGION_MEMBERS = {
    'Northern Africa and Western Asia': ['Egypt','Morocco','Algeria','Tunisia','Libya','Sudan',
